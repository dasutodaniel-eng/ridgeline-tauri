{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ridgeline",
  "version": "0.1.0-beta",
  "identifier": "dev.dasuto.ridgeline-tauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ridgeline",
        "width": 980,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "backgroundColor": "#141414",
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; media-src 'self' blob: https: http://media.localhost http://scproxy.localhost; connect-src 'self' https: http://scproxy.localhost http://ipc.localhost ipc:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["mp3"], "name": "MP3 Audio", "role": "Viewer" },
      { "ext": ["flac"], "name": "FLAC Audio", "role": "Viewer" },
      { "ext": ["ogg"], "name": "OGG Audio", "role": "Viewer" },
      { "ext": ["wav"], "name": "WAV Audio", "role": "Viewer" },
      { "ext": ["m4a"], "name": "M4A Audio", "role": "Viewer" }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
